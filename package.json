{
  "name": "pidb-monorepo",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "workspaces": ["packages/*"],
  "scripts": {
    "build": "npm run build -w @pidb/shared && npm run build -w @pidb/server",
    "typecheck": "npm run build -w @pidb/shared && tsc -p packages/server/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.23.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.0"
  }
}
