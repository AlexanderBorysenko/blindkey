<p class="crumbs">
  <% if (it.prefix === '/global') { %>
  <a href="/global/secrets">Global</a> / <a href="/global/secrets">Secrets</a> / <span class="current"><%= it.secret.name %></span>
  <% } else { %>
  <a href="/">Projects</a> / <a href="<%= it.prefix %>?tab=secrets"><%= it.scopeLabel %></a> / <a href="<%= it.prefix %>?tab=secrets">Secrets</a> / <span class="current"><%= it.secret.name %></span>
  <% } %>
</p>

<div class="page-head">
  <div>
    <h1 class="mono"><%= it.secret.name %></h1>
    <% if (it.secret.description) { %><p class="lede"><%= it.secret.description %></p><% } %>
    <% if (it.secret.tags.length) { %>
    <div class="meta">
      <% it.secret.tags.forEach(function (tag) { %><span class="tag"><%= tag %></span><% }) %>
    </div>
    <% } %>
  </div>
  <div class="actions">
    <a class="btn" href="<%= it.prefix %>/secrets/<%= encodeURIComponent(it.secret.name) %>/edit">Edit</a>
    <details class="menu">
      <summary class="btn ghost" aria-label="More actions">⋯</summary>
      <div class="menu-list">
        <button class="btn ghost danger" type="button" onclick="document.getElementById('delete-secret').showModal()">Delete secret…</button>
      </div>
    </details>
  </div>
</div>

<div class="secret-grid">
  <div>
    <p class="note"><svg class="i" aria-hidden="true"><use href="#i-lock"/></svg> Every reveal is written to the audit log.</p>
    <div class="kv">
      <% it.secret.fields.forEach(function (f) { %>
      <% if (f.sensitive) { %>
      <%~ include('partials/masked-row', { key: f.key, csrf: it.csrf, prefix: it.prefix, secretName: it.secret.name }) %>
      <template data-masked-row="<%= f.key %>"><%~ include('partials/masked-row', { key: f.key, csrf: it.csrf, prefix: it.prefix, secretName: it.secret.name }) %></template>
      <% } else { %>
      <div class="kv-row" data-field-row="<%= f.key %>">
        <div class="mono field-key"><%= f.key %></div>
        <div data-field="<%= f.key %>">
          <span class="field-value<%= (f.value ?? '').includes('\n') ? ' multiline' : '' %>"><%= f.value %></span>
        </div>
        <div>
          <button class="btn sm ghost" type="button" onclick="copyField(this)">Copy</button>
        </div>
      </div>
      <% } %>
      <% }) %>
    </div>
  </div>

  <div>
    <div class="panel">
      <h3>Use without revealing</h3>
      <pre><code>pidb secret env <%= it.cliRef %></code></pre>
      <p class="note">Also see <code>pidb secret exec</code> and <code>pidb secret write</code>.</p>
    </div>
    <div class="panel">
      <h3>Recent access</h3>
      <% if (it.access.length === 0) { %>
      <p class="note">No access recorded yet.</p>
      <% } else { %>
      <ul class="access-list">
        <% it.access.forEach(function (a) { %>
        <li>
          <time datetime="<%= it.fmt.iso(a.ts) %>" title="<%= it.fmt.iso(a.ts) %>"><%= it.fmt.ago(a.ts) %></time>
          <span><%= a.actor_type === 'admin' ? 'you' : ('token #' + a.actor_id) %></span>
          <% if (a.action === 'secret.reveal') { %>
          <span class="mono text-lock">revealed <%= a.field_key %></span>
          <% } else if (a.action === 'secret.update') { %>
          <span>edited</span>
          <% } else if (a.action === 'secret.create') { %>
          <span>created</span>
          <% } else { %>
          <span class="mono"><%= a.action %></span>
          <% } %>
        </li>
        <% }) %>
      </ul>
      <% } %>
      <p><a href="/audit">Full audit log</a></p>
    </div>
  </div>
</div>

<dialog class="confirm" id="delete-secret">
  <h2>Delete secret</h2>
  <p>Delete <%= it.secret.name %> and all its fields? This cannot be undone.</p>
  <form method="post" action="<%= it.prefix %>/secrets/<%= encodeURIComponent(it.secret.name) %>/delete">
    <input type="hidden" name="csrf" value="<%= it.csrf %>" />
    <div class="actions">
      <button class="btn" type="button" onclick="this.closest('dialog').close()">Cancel</button>
      <button class="btn danger solid" type="submit">Delete secret</button>
    </div>
  </form>
</dialog>

<script>
  // Client-side only: re-masks a value swapped in by the reveal partial. Revealing again is a
  // new audited request. Field keys never flow through string-built HTML or CSS selectors here:
  // the masked-row template is looked up with CSS.escape, and the value/timer within a row are
  // found via closest()/querySelector('[data-field]') scoped to that row.
  var pidbTimers = new WeakMap();

  function stopTimer(row) {
    var timerEl = row.querySelector('.timer[data-seconds]');
    if (timerEl && pidbTimers.has(timerEl)) {
      clearInterval(pidbTimers.get(timerEl));
      pidbTimers.delete(timerEl);
    }
  }

  function hideField(btn) {
    var row = btn.closest('.kv-row');
    if (!row) return;
    stopTimer(row);
    var key = row.getAttribute('data-field-row') || '';
    var tmpl = document.querySelector('template[data-masked-row="' + CSS.escape(key) + '"]');
    if (tmpl && tmpl.content.firstElementChild) {
      var clone = tmpl.content.firstElementChild.cloneNode(true);
      row.replaceWith(clone);
      // htmx only wires up hx-* attributes on elements it has processed. A clone taken from a
      // <template> was never seen by htmx's MutationObserver-free init pass, so without this the
      // restored Reveal form would fall back to a plain (non-htmx) POST and navigate the whole
      // page to the bare partial fragment instead of swapping the row.
      if (window.htmx && typeof htmx.process === 'function') htmx.process(clone);
    } else {
      row.remove();
    }
  }

  function copyField(btn) {
    var row = btn.closest('.kv-row');
    // Copy the value element itself, not its container: the container's whitespace/indentation
    // around the <span> would otherwise be copied along with the value.
    var valueEl = row ? row.querySelector('.field-value') : null;
    if (!valueEl) return;
    navigator.clipboard.writeText(valueEl.textContent).then(function () {
      var original = btn.textContent;
      btn.textContent = 'Copied';
      setTimeout(function () { btn.textContent = original; }, 1500);
    });
  }

  function startTimers(root) {
    root.querySelectorAll('.timer[data-seconds]').forEach(function (el) {
      if (pidbTimers.has(el)) return;
      var row = el.closest('.kv-row');
      var seconds = parseInt(el.getAttribute('data-seconds'), 10) || 0;
      var id = setInterval(function () {
        seconds -= 1;
        if (seconds <= 0) {
          clearInterval(id);
          pidbTimers.delete(el);
          var hideBtn = row ? row.querySelector('[data-hide]') : null;
          if (hideBtn) hideField(hideBtn);
        } else {
          el.textContent = 'hides in ' + seconds + ' s';
        }
      }, 1000);
      pidbTimers.set(el, id);
    });
  }

  document.body.addEventListener('htmx:afterSwap', function () {
    startTimers(document);
  });
  startTimers(document);
</script>
