<p class="crumbs">
  <% if (it.prefix === '/global') { %>
  <a href="/global/secrets">Global</a> / <a href="/global/secrets">Secrets</a> / <span class="current"><%= it.secret.name %></span>
  <% } else { %>
  <a href="/">Projects</a> / <a href="<%= it.prefix %>?tab=secrets"><%= it.scopeLabel %></a> / <a href="<%= it.prefix %>?tab=secrets">Secrets</a> / <span class="current"><%= it.secret.name %></span>
  <% } %>
</p>

<div class="page-head">
  <div>
    <h1 class="mono"><%= it.secret.name %></h1>
    <% if (it.secret.description) { %><p class="lede"><%= it.secret.description %></p><% } %>
    <% if (it.secret.tags.length) { %>
    <div class="meta">
      <% it.secret.tags.forEach(function (tag) { %><span class="tag"><%= tag %></span><% }) %>
    </div>
    <% } %>
  </div>
  <div class="actions">
    <a class="btn" href="<%= it.prefix %>/secrets/<%= encodeURIComponent(it.secret.name) %>/edit">Edit</a>
    <details class="menu">
      <summary class="btn ghost" aria-label="More actions">⋯</summary>
      <div class="menu-list">
        <button class="btn ghost danger" type="button" data-open-dialog="delete-secret">Delete secret…</button>
      </div>
    </details>
  </div>
</div>

<div class="secret-grid">
  <div>
    <p class="note"><svg class="i" aria-hidden="true"><use href="#i-lock"/></svg> Every reveal is written to the audit log.</p>
    <div class="kv">
      <% it.secret.fields.forEach(function (f) { %>
      <% if (f.sensitive) { %>
      <%~ include('partials/masked-row', { key: f.key, csrf: it.csrf, prefix: it.prefix, secretName: it.secret.name }) %>
      <template data-masked-row="<%= f.key %>"><%~ include('partials/masked-row', { key: f.key, csrf: it.csrf, prefix: it.prefix, secretName: it.secret.name }) %></template>
      <% } else { %>
      <div class="kv-row" data-field-row="<%= f.key %>">
        <div class="mono field-key"><%= f.key %></div>
        <div data-field="<%= f.key %>">
          <span class="field-value<%= (f.value ?? '').includes('\n') ? ' multiline' : '' %>"><%= f.value %></span>
        </div>
        <div>
          <button class="btn sm ghost" type="button" data-action="copy-field">Copy</button>
        </div>
      </div>
      <% } %>
      <% }) %>
    </div>
  </div>

  <div>
    <div class="panel">
      <h3>Use without revealing</h3>
      <pre><code>blindkey secret env <%= it.cliRef %></code></pre>
      <p class="note">Also see <code>blindkey secret exec</code> and <code>blindkey secret write</code>.</p>
    </div>
    <div class="panel">
      <h3>Recent access</h3>
      <% if (it.access.length === 0) { %>
      <p class="note">No access recorded yet.</p>
      <% } else { %>
      <ul class="access-list">
        <% it.access.forEach(function (a) { %>
        <li>
          <time datetime="<%= it.fmt.iso(a.ts) %>" title="<%= it.fmt.iso(a.ts) %>"><%= it.fmt.ago(a.ts) %></time>
          <span><%= a.actor_type === 'admin' ? 'you' : ('token #' + a.actor_id) %></span>
          <% if (a.action === 'secret.reveal') { %>
          <span class="mono text-lock">revealed <%= a.field_key %></span>
          <% } else if (a.action === 'secret.update') { %>
          <span>edited</span>
          <% } else if (a.action === 'secret.create') { %>
          <span>created</span>
          <% } else { %>
          <span class="mono"><%= a.action %></span>
          <% } %>
        </li>
        <% }) %>
      </ul>
      <% } %>
      <p><a href="/audit">Full audit log</a></p>
    </div>
  </div>
</div>

<dialog class="confirm" id="delete-secret">
  <h2>Delete secret</h2>
  <p>Delete <%= it.secret.name %> and all its fields? This cannot be undone.</p>
  <form method="post" action="<%= it.prefix %>/secrets/<%= encodeURIComponent(it.secret.name) %>/delete">
    <input type="hidden" name="csrf" value="<%= it.csrf %>" />
    <div class="actions">
      <button class="btn" type="button" data-close-dialog>Cancel</button>
      <button class="btn danger solid" type="submit">Delete secret</button>
    </div>
  </form>
</dialog>
