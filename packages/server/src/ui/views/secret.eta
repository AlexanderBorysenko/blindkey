<p><a href="<%= it.prefix === '/global' ? '/global/secrets' : it.prefix + '?tab=secrets' %>">← <%= it.scopeLabel %></a></p>
<h1><%= it.secret.name %></h1>
<% if (it.secret.description) { %><p><%= it.secret.description %></p><% } %>
<% if (it.secret.tags.length) { %><p><small><%= it.secret.tags.join(', ') %></small></p><% } %>

<table>
  <thead><tr><th>Key</th><th>Value</th><th></th></tr></thead>
  <tbody>
    <% it.secret.fields.forEach(function (f) { %>
    <tr>
      <td><code><%= f.key %></code></td>
      <td data-field="<%= f.key %>">
        <% if (f.sensitive) { %>
        <span class="masked">••••••••</span>
        <% } else { %>
        <span class="field-value"><%= f.value %></span>
        <% } %>
      </td>
      <td>
        <% if (f.sensitive) { %>
        <form method="post" action="<%= it.prefix %>/secrets/<%= encodeURIComponent(it.secret.name) %>/reveal"
              hx-post="<%= it.prefix %>/secrets/<%= encodeURIComponent(it.secret.name) %>/reveal"
              hx-target="[data-field='<%= f.key %>']">
          <input type="hidden" name="csrf" value="<%= it.csrf %>" />
          <input type="hidden" name="key" value="<%= f.key %>" />
          <button class="outline" type="submit">Reveal</button>
        </form>
        <% } %>
      </td>
    </tr>
    <% }) %>
  </tbody>
</table>

<p><small>Every reveal is written to the audit log. To use a value in a command or a file, prefer
<code>pidb secret exec</code>, <code>pidb secret write</code> or <code>pidb secret env</code>.</small></p>

<div class="row-actions">
  <a role="button" href="<%= it.prefix %>/secrets/<%= encodeURIComponent(it.secret.name) %>/edit">Edit</a>
  <form method="post" action="<%= it.prefix %>/secrets/<%= encodeURIComponent(it.secret.name) %>/delete" onsubmit="return confirm('Delete this secret and all its fields?');">
    <input type="hidden" name="csrf" value="<%= it.csrf %>" />
    <button class="secondary outline" type="submit">Delete</button>
  </form>
</div>
