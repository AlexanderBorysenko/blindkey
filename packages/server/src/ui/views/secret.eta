<p class="crumbs">
  <% if (it.prefix === '/global') { %>
  <a href="/global/secrets<%= it.wsq %>">Global</a> / <a href="/global/secrets<%= it.wsq %>">Secrets</a> / <span class="current"><%= it.secret.name %></span>
  <% } else { %>
  <a href="/">Projects</a> / <a href="<%= it.prefix %>?tab=secrets"><%= it.scopeLabel %></a> / <a href="<%= it.prefix %>?tab=secrets">Secrets</a> / <span class="current"><%= it.secret.name %></span>
  <% } %>
</p>

<div class="page-head">
  <div>
    <h1 class="mono"><%= it.secret.name %></h1>
    <% if (it.secret.description) { %><p class="lede"><%= it.secret.description %></p><% } %>
    <% if (it.secret.tags.length) { %>
    <div class="meta">
      <% it.secret.tags.forEach(function (tag) { %><span class="tag"><%= tag %></span><% }) %>
    </div>
    <% } %>
  </div>
  <div class="actions">
    <% if (it.canEdit) { %><a class="btn" href="<%= it.prefix %>/secrets/<%= encodeURIComponent(it.secret.name) %>/edit<%= it.wsq %>">Edit</a><% } %>
    <% if (it.canDelete || (it.moveTargets && it.moveTargets.length)) { %>
    <details class="menu">
      <summary class="btn ghost" aria-label="More actions">⋯</summary>
      <div class="menu-list">
        <% if (it.moveTargets && it.moveTargets.length) { %><button class="btn ghost" type="button" data-open-dialog="move-item">Move to workspace…</button><% } %>
        <% if (it.canDelete) { %><button class="btn ghost danger" type="button" data-open-dialog="delete-secret">Delete secret…</button><% } %>
      </div>
    </details>
    <% } %>
  </div>
</div>

<% if (it.moveError) { %><p role="alert" class="alert"><%= it.moveError %></p><% } %>

<div class="secret-grid">
  <div>
    <p class="note"><svg class="i" aria-hidden="true"><use href="#i-lock"/></svg> Every reveal is written to the audit log.</p>
    <div class="kv">
      <% it.secret.fields.forEach(function (f) { %>
      <% if (f.sensitive) { %>
      <%~ include('partials/masked-row', { key: f.key, csrf: it.csrf, ws: it.ws, prefix: it.prefix, secretName: it.secret.name, canReveal: it.canReveal }) %>
      <template data-masked-row="<%= f.key %>"><%~ include('partials/masked-row', { key: f.key, csrf: it.csrf, ws: it.ws, prefix: it.prefix, secretName: it.secret.name, canReveal: it.canReveal }) %></template>
      <% } else { %>
      <% if (f.value === undefined) { %>
      <div class="kv-row" data-field-row="<%= f.key %>">
        <div class="mono field-key locked"><svg class="i" aria-hidden="true"><use href="#i-lock"/></svg> <%= f.key %></div>
        <div data-field="<%= f.key %>"><span class="masked">••••••••••••</span></div>
        <div></div>
      </div>
      <% } else { %>
      <div class="kv-row" data-field-row="<%= f.key %>">
        <div class="mono field-key"><%= f.key %></div>
        <div data-field="<%= f.key %>">
          <span class="field-value<%= (f.value ?? '').includes('\n') ? ' multiline' : '' %>"><%= f.value %></span>
        </div>
        <div>
          <button class="btn sm ghost" type="button" data-action="copy-field">Copy</button>
        </div>
      </div>
      <% } %>
      <% } %>
      <% }) %>
    </div>
  </div>

  <div>
    <div class="panel">
      <h3>Recent access</h3>
      <% if (it.access.length === 0) { %>
      <p class="note">No access recorded yet.</p>
      <% } else { %>
      <ul class="access-list">
        <% it.access.forEach(function (a) { %>
        <li>
          <time datetime="<%= it.fmt.iso(a.ts) %>" title="<%= it.fmt.iso(a.ts) %>"><%= it.fmt.ago(a.ts) %></time>
          <span><%= a.actor_label %></span>
          <% if (a.action === 'secret.reveal') { %>
          <span class="mono text-lock">revealed <%= a.field_key %></span>
          <% } else if (a.action === 'secret.update') { %>
          <span>edited</span>
          <% } else if (a.action === 'secret.create') { %>
          <span>created</span>
          <% } else { %>
          <span class="mono"><%= a.action %></span>
          <% } %>
        </li>
        <% }) %>
      </ul>
      <% } %>
      <p><a href="/audit">Full audit log</a></p>
    </div>
  </div>
</div>

<% if (it.canDelete) { %>
<dialog class="confirm" id="delete-secret">
  <h2>Delete secret</h2>
  <p>Delete <%= it.secret.name %> and all its fields? This cannot be undone.</p>
  <form method="post" action="<%= it.prefix %>/secrets/<%= encodeURIComponent(it.secret.name) %>/delete">
    <input type="hidden" name="csrf" value="<%= it.csrf %>" />
    <% if (it.ws) { %><input type="hidden" name="workspace" value="<%= it.ws %>" /><% } %>
    <div class="actions">
      <button class="btn" type="button" data-close-dialog>Cancel</button>
      <button class="btn danger solid" type="submit">Delete secret</button>
    </div>
  </form>
</dialog>
<% } %>

<%~ include('partials/move-dialog', { targets: it.moveTargets, action: it.prefix + '/secrets/' + encodeURIComponent(it.secret.name) + '/move', csrf: it.csrf, ws: it.ws, what: it.secret.name }) %>
