<div class="page-head">
  <div>
    <h1>Password</h1>
    <p class="lede">Change the admin account password.</p>
  </div>
</div>

<% if (it.error) { %><p role="alert" class="alert"><%= it.error %></p><% } %>

<div class="panel">
  <h3>Change password</h3>
  <p class="note">API tokens are not revoked by a password change — they are independent credentials, listed on <a href="/tokens">API tokens</a>.</p>
  <form method="post" action="/settings/password" class="form-grid">
    <input type="hidden" name="csrf" value="<%= it.csrf %>" />
    <label>Current password <input type="password" name="current" autocomplete="current-password" required /></label>
    <label>New password <input type="password" name="next" autocomplete="new-password" required /></label>
    <label>Confirm new password <input type="password" name="confirm" autocomplete="new-password" required /></label>
    <% if (it.totpEnabled) { %>
    <label>Code <input name="code" autocomplete="one-time-code" inputmode="text" required /></label>
    <% } %>
    <button class="btn primary" type="submit">Change password</button>
  </form>
</div>
