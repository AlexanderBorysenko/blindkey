<p class="crumbs"><%= it.workspace.name %> / <span class="current">Settings</span></p>
<div class="page-head">
  <div>
    <h1>Workspace settings</h1>
  </div>
</div>
<%~ include('partials/workspace-tabs', { slug: it.workspace.slug, tab: 'settings' }) %>
<% if (it.error) { %><p role="alert" class="alert"><%= it.error %></p><% } %>
<form method="post" action="/w/<%= encodeURIComponent(it.workspace.slug) %>/settings" class="form-grid">
  <input type="hidden" name="csrf" value="<%= it.csrf %>" />
  <label>Name <input name="name" value="<%= it.form.name %>" required maxlength="200" /></label>
  <label>Slug <input name="slug" value="<%= it.form.slug %>" required pattern="[a-z0-9]+(-[a-z0-9]+)*" />
    <small>Changing the slug changes workspace addresses used by the CLI and API.</small>
  </label>
  <div class="actions">
    <button class="btn primary" type="submit">Save</button>
  </div>
</form>
