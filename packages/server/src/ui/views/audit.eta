<div class="page-head">
  <div>
    <h1>Audit log</h1>
  </div>
</div>

<form method="get" action="/audit" class="toolbar filters">
  <label>Action <input name="action" value="<%= it.action %>" placeholder="e.g. auth.login" /></label>
  <label>Actor
    <select name="actor">
      <option value=""<%= it.actor === '' ? ' selected' : '' %>>any</option>
      <option value="admin"<%= it.actor === 'admin' ? ' selected' : '' %>>admin</option>
      <option value="token"<%= it.actor === 'token' ? ' selected' : '' %>>token</option>
    </select>
  </label>
  <label>Rows <input name="limit" type="number" min="1" max="200" value="<%= it.limit %>" /></label>
  <button class="btn primary" type="submit">Filter</button>
  <a class="btn ghost" href="/audit">Reset</a>
</form>

<% if (it.rows.length === 0) { %>
<div class="empty">
  <p>No audit entries match these filters.</p>
</div>
<% } else { %>
<div class="table-wrap">
  <table>
    <thead><tr><th>ID</th><th>When</th><th>Actor</th><th>Action</th><th>Target</th><th>Field</th><th>IP</th></tr></thead>
    <tbody>
      <% it.rows.forEach(function (r) { %>
      <% var actClass = ''; %>
      <% if (/reveal(_all)?$/.test(r.action)) { actClass = 'act-reveal'; } else if (/(\.delete|revoke)$/.test(r.action)) { actClass = 'act-delete'; } else if (r.action.indexOf('auth.') === 0) { actClass = 'act-auth'; } %>
      <tr<%~ actClass ? ' class="' + actClass + '"' : '' %>>
        <td><%= r.id %></td>
        <td><time datetime="<%= it.fmt.iso(r.ts) %>" title="<%= it.fmt.iso(r.ts) %>"><%= it.fmt.ago(r.ts) %></time></td>
        <td><%= r.actor_type %><%= r.actor_id === null ? '' : ' #' + r.actor_id %></td>
        <td><%= r.action %></td>
        <td class="mono"><%= r.target_type === null ? '' : r.target_type + ' #' + r.target_id %></td>
        <td><%= r.field_key === null ? '' : r.field_key %></td>
        <td><%= r.ip %></td>
      </tr>
      <% }) %>
    </tbody>
  </table>
</div>
<% } %>

<p class="row-actions">
  <a class="btn ghost" href="<%= it.resetHref %>">Newest</a>
  <% if (it.olderHref) { %><a class="btn sm" href="<%= it.olderHref %>">Older →</a><% } %>
</p>
