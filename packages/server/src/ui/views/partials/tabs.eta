<nav class="tabs">
  <a href="/p/<%= encodeURIComponent(it.slug) %>" aria-current="<%~ it.tab === 'docs' ? 'page' : 'false' %>">Documents <span class="count" data-count="<%= it.docsCount %>"><%= it.docsCount %></span></a>
  <a href="/p/<%= encodeURIComponent(it.slug) %>?tab=secrets" aria-current="<%~ it.tab === 'secrets' ? 'page' : 'false' %>">Secrets <span class="count" data-count="<%= it.secretsCount %>"><%= it.secretsCount %></span></a>
</nav>
