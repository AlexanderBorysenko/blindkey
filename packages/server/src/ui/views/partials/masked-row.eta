<div class="kv-row" data-field-row="<%= it.key %>">
  <div class="mono field-key locked"><svg class="i" aria-hidden="true"><use href="#i-lock"/></svg> <%= it.key %></div>
  <div data-field="<%= it.key %>"><span class="masked">••••••••••••</span></div>
  <div>
    <form method="post" action="<%= it.prefix %>/secrets/<%= encodeURIComponent(it.secretName) %>/reveal"
          hx-post="<%= it.prefix %>/secrets/<%= encodeURIComponent(it.secretName) %>/reveal"
          hx-target="closest .kv-row" hx-swap="outerHTML">
      <input type="hidden" name="csrf" value="<%= it.csrf %>" />
      <input type="hidden" name="key" value="<%= it.key %>" />
      <button class="btn sm" type="submit"><svg class="i" aria-hidden="true"><use href="#i-eye"/></svg> Reveal</button>
    </form>
  </div>
</div>
