<p class="crumbs">
  <% if (it.prefix === '/global') { %>
  <a href="/global/secrets">Global</a> / <a href="/global/secrets">Secrets</a> / <span class="current"><%= it.isNew ? 'New secret' : it.originalName %></span>
  <% } else { %>
  <a href="/">Projects</a> / <a href="<%= it.prefix %>?tab=secrets"><%= it.scopeLabel %></a> / <a href="<%= it.prefix %>?tab=secrets">Secrets</a> / <span class="current"><%= it.isNew ? 'New secret' : it.originalName %></span>
  <% } %>
</p>

<h1><%= it.isNew ? 'New secret' : 'Edit secret' %></h1>
<% if (it.error) { %><div class="alert" role="alert"><%= it.error %></div><% } %>

<form method="post" action="<%= it.action %>">
  <input type="hidden" name="csrf" value="<%= it.csrf %>" />

  <div class="form-grid">
    <label>Name <input name="name" value="<%= it.form.name %>" required /></label>
    <label>Description <input name="description" value="<%= it.form.description %>" /></label>
    <label>
      Tags <input name="tags" value="<%= it.form.tags %>" />
      <small>comma separated</small>
    </label>
  </div>

  <h2>Fields</h2>
  <% if (!it.isNew) { %><p class="note">Leave a locked value empty to keep the stored one.</p><% } %>

  <div id="rows">
    <% it.form.rows.forEach(function (r) { %>
    <div class="field-card<%= r.sensitive ? ' is-locked' : '' %>">
      <input name="key" value="<%= r.key %>" placeholder="password" aria-label="Key" />
      <textarea name="value" rows="<%= r.value.includes('\n') ? 6 : 1 %>" placeholder="<%= it.isNew ? '' : 'unchanged' %>" spellcheck="false" aria-label="Value"><%= r.value %></textarea>
      <div class="field-controls">
        <button type="button" class="btn sm lock-toggle" aria-pressed="<%= r.sensitive ? 'true' : 'false' %>" onclick="toggleLock(this)">
          <svg class="i" aria-hidden="true"><use href="#i-lock"/></svg> <%= r.sensitive ? 'Locked' : 'Visible' %>
        </button>
        <input type="hidden" name="sensitive" value="<%= r.sensitive ? '1' : '0' %>" />
        <div class="row-buttons">
          <button type="button" class="btn sm ghost" title="Move up" aria-label="Move up" onclick="moveRow(this, -1)">↑</button>
          <button type="button" class="btn sm ghost" title="Move down" aria-label="Move down" onclick="moveRow(this, 1)">↓</button>
          <button type="button" class="btn sm ghost" onclick="this.closest('.field-card').remove()" title="Remove" aria-label="Remove">✕</button>
        </div>
      </div>
    </div>
    <% }) %>
  </div>

  <p class="row-actions">
    <button type="button" class="btn sm ghost" onclick="addRow('')">Add field</button>
    <% it.hintKeys.forEach(function (k) { %>
    <button type="button" class="btn sm ghost" onclick="addRow('<%= k %>')"><%= k %></button>
    <% }) %>
  </p>

  <div class="save-bar">
    <button class="btn primary" type="submit">Save</button>
    <a class="btn" href="<%= it.isNew ? (it.prefix === '/global' ? '/global/secrets' : it.prefix + '?tab=secrets') : it.prefix + '/secrets/' + encodeURIComponent(it.originalName) %>">Cancel</a>
  </div>
</form>

<script>
  // Non-sensitive hint keys (plain identifiers from @pidb/shared NON_SENSITIVE_KEYS) start a new
  // row Visible; every other key starts Locked, mirroring the server's defaultSensitive() default.
  var hintKeys = <%~ JSON.stringify(it.hintKeys).replace(/</g, '\\u003c') %>;

  function lockToggleLabel(btn, locked) {
    btn.innerHTML = '<svg class="i" aria-hidden="true"><use href="#i-lock"/></svg> ' + (locked ? 'Locked' : 'Visible');
  }

  function toggleLock(btn) {
    var card = btn.closest('.field-card');
    var hidden = card.querySelector('input[name="sensitive"]');
    var locked = hidden.value !== '1';
    hidden.value = locked ? '1' : '0';
    btn.setAttribute('aria-pressed', locked ? 'true' : 'false');
    card.classList.toggle('is-locked', locked);
    lockToggleLabel(btn, locked);
  }

  // A new row's key is set via .value (never concatenated into an HTML string), so a hint key
  // (trusted today) or any future free-typed key can never break out of its attribute/text slot.
  function addRow(key) {
    var rows = document.getElementById('rows');
    var locked = hintKeys.indexOf(key) === -1;

    var card = document.createElement('div');
    card.className = 'field-card' + (locked ? ' is-locked' : '');

    var keyInput = document.createElement('input');
    keyInput.name = 'key';
    keyInput.value = key;
    keyInput.placeholder = 'password';
    keyInput.setAttribute('aria-label', 'Key');
    card.appendChild(keyInput);

    var valueArea = document.createElement('textarea');
    valueArea.name = 'value';
    valueArea.rows = 1;
    valueArea.spellcheck = false;
    valueArea.setAttribute('aria-label', 'Value');
    card.appendChild(valueArea);

    var controls = document.createElement('div');
    controls.className = 'field-controls';

    var lockBtn = document.createElement('button');
    lockBtn.type = 'button';
    lockBtn.className = 'btn sm lock-toggle';
    lockBtn.setAttribute('aria-pressed', locked ? 'true' : 'false');
    lockBtn.setAttribute('onclick', 'toggleLock(this)');
    lockToggleLabel(lockBtn, locked);
    controls.appendChild(lockBtn);

    var sensitiveInput = document.createElement('input');
    sensitiveInput.type = 'hidden';
    sensitiveInput.name = 'sensitive';
    sensitiveInput.value = locked ? '1' : '0';
    controls.appendChild(sensitiveInput);

    var rowButtons = document.createElement('div');
    rowButtons.className = 'row-buttons';

    var up = document.createElement('button');
    up.type = 'button';
    up.className = 'btn sm ghost';
    up.title = 'Move up';
    up.setAttribute('aria-label', 'Move up');
    up.setAttribute('onclick', 'moveRow(this, -1)');
    up.textContent = '↑';
    rowButtons.appendChild(up);

    var down = document.createElement('button');
    down.type = 'button';
    down.className = 'btn sm ghost';
    down.title = 'Move down';
    down.setAttribute('aria-label', 'Move down');
    down.setAttribute('onclick', 'moveRow(this, 1)');
    down.textContent = '↓';
    rowButtons.appendChild(down);

    var remove = document.createElement('button');
    remove.type = 'button';
    remove.className = 'btn sm ghost';
    remove.title = 'Remove';
    remove.setAttribute('aria-label', 'Remove');
    remove.addEventListener('click', function () { card.remove(); });
    remove.textContent = '✕';
    rowButtons.appendChild(remove);

    controls.appendChild(rowButtons);
    card.appendChild(controls);
    rows.appendChild(card);
  }

  // Rows are submitted positionally, so moving the .field-card is all a reorder needs.
  function moveRow(btn, dir) {
    var card = btn.closest('.field-card');
    var sibling = dir < 0 ? card.previousElementSibling : card.nextElementSibling;
    if (!sibling) return;
    if (dir < 0) card.parentNode.insertBefore(card, sibling);
    else card.parentNode.insertBefore(sibling, card);
    btn.focus();
  }
</script>
