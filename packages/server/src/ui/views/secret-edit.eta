<p><a href="<%= it.prefix === '/global' ? '/global/secrets' : it.prefix + '?tab=secrets' %>">← <%= it.scopeLabel %></a></p>
<h1><%= it.isNew ? 'New secret' : 'Edit secret' %></h1>
<% if (it.error) { %><p role="alert"><%= it.error %></p><% } %>

<form method="post" action="<%= it.action %>">
  <input type="hidden" name="csrf" value="<%= it.csrf %>" />
  <label>Name <input name="name" value="<%= it.form.name %>" required /></label>
  <label>Description <input name="description" value="<%= it.form.description %>" /></label>
  <label>Tags (comma separated) <input name="tags" value="<%= it.form.tags %>" /></label>

  <div class="table-scroll">
  <table id="rows" class="field-rows">
    <thead><tr><th>Key</th><th>Value</th><th>Sensitive</th><th></th></tr></thead>
    <tbody>
      <% it.form.rows.forEach(function (r) { %>
      <tr>
        <td><input name="key" value="<%= r.key %>" placeholder="password" /></td>
        <td><textarea name="value" rows="<%= r.value.includes('\n') ? 6 : 1 %>" placeholder="<%= it.isNew ? '' : 'unchanged' %>" spellcheck="false"><%= r.value %></textarea></td>
        <td>
          <select name="sensitive">
            <option value="1"<%= r.sensitive ? ' selected' : '' %>>Sensitive</option>
            <option value="0"<%= !r.sensitive ? ' selected' : '' %>>Visible</option>
          </select>
        </td>
        <td>
          <div class="row-buttons">
            <button type="button" class="secondary outline" title="Move up" aria-label="Move up" onclick="moveRow(this, -1)">↑</button>
            <button type="button" class="secondary outline" title="Move down" aria-label="Move down" onclick="moveRow(this, 1)">↓</button>
            <button type="button" class="secondary outline" onclick="this.closest('tr').remove()" title="Remove" aria-label="Remove">✕</button>
          </div>
        </td>
      </tr>
      <% }) %>
    </tbody>
  </table>
  </div>

  <p class="row-actions">
    <button type="button" class="outline" onclick="addRow('')">Add field</button>
    <% it.hintKeys.forEach(function (k) { %>
    <button type="button" class="outline" onclick="addRow('<%= k %>')"><%= k %></button>
    <% }) %>
  </p>

  <button type="submit">Save</button>
</form>

<script>
  function addRow(key) {
    const tbody = document.querySelector('#rows tbody');
    const tr = document.createElement('tr');
    tr.innerHTML =
      '<td><input name="key" value="' + key + '" /></td>' +
      '<td><textarea name="value" rows="1" spellcheck="false"></textarea></td>' +
      '<td><select name="sensitive"><option value="1" selected>Sensitive</option><option value="0">Visible</option></select></td>' +
      '<td><div class="row-buttons">' +
      '<button type="button" class="secondary outline" title="Move up" aria-label="Move up" onclick="moveRow(this, -1)">↑</button>' +
      '<button type="button" class="secondary outline" title="Move down" aria-label="Move down" onclick="moveRow(this, 1)">↓</button>' +
      '<button type="button" class="secondary outline" onclick="this.closest(\'tr\').remove()" title="Remove" aria-label="Remove">✕</button>' +
      '</div></td>';
    tbody.appendChild(tr);
  }
  // Rows are submitted positionally, so moving the <tr> is all a reorder needs.
  function moveRow(btn, dir) {
    const tr = btn.closest('tr');
    const sibling = dir < 0 ? tr.previousElementSibling : tr.nextElementSibling;
    if (!sibling) return;
    if (dir < 0) tr.parentNode.insertBefore(tr, sibling);
    else tr.parentNode.insertBefore(sibling, tr);
    btn.focus();
  }
</script>
