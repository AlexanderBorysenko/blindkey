<p><a href="<%= it.prefix === '/global' ? '/global/secrets' : it.prefix + '?tab=secrets' %>">← <%= it.scopeLabel %></a></p>
<h1><%= it.isNew ? 'New secret' : 'Edit secret' %></h1>
<% if (it.error) { %><p role="alert"><%= it.error %></p><% } %>

<form method="post" action="<%= it.action %>">
  <input type="hidden" name="csrf" value="<%= it.csrf %>" />
  <label>Name <input name="name" value="<%= it.form.name %>" required <%= it.isNew ? '' : 'readonly' %> /></label>
  <label>Description <input name="description" value="<%= it.form.description %>" /></label>
  <label>Tags (comma separated) <input name="tags" value="<%= it.form.tags %>" /></label>

  <table id="rows">
    <thead><tr><th>Key</th><th>Value</th><th>Sensitive</th><th></th></tr></thead>
    <tbody>
      <% it.form.rows.forEach(function (r) { %>
      <tr>
        <td><input name="key" value="<%= r.key %>" placeholder="password" /></td>
        <td><input name="value" value="<%= r.value %>" placeholder="<%= it.isNew ? '' : 'unchanged' %>" /></td>
        <td><input type="checkbox" name="sensitive" value="<%= r.key %>"<%= r.sensitive ? ' checked' : '' %> /></td>
        <td><button type="button" class="secondary outline" onclick="this.closest('tr').remove()">Remove</button></td>
      </tr>
      <% }) %>
    </tbody>
  </table>

  <p>
    <button type="button" class="outline" onclick="addRow('')">Add field</button>
    <% it.hintKeys.forEach(function (k) { %>
    <button type="button" class="outline" onclick="addRow('<%= k %>')"><%= k %></button>
    <% }) %>
  </p>

  <button type="submit">Save</button>
</form>

<script>
  function addRow(key) {
    const tbody = document.querySelector('#rows tbody');
    const tr = document.createElement('tr');
    tr.innerHTML =
      '<td><input name="key" value="' + key + '" /></td>' +
      '<td><input name="value" value="" /></td>' +
      '<td><input type="checkbox" name="sensitive" value="' + key + '" /></td>' +
      '<td><button type="button" class="secondary outline" onclick="this.closest(\'tr\').remove()">Remove</button></td>';
    tbody.appendChild(tr);
    const keyInput = tr.querySelector('input[name="key"]');
    const box = tr.querySelector('input[name="sensitive"]');
    // The checkbox submits the row's key, so keep it in step while the user types.
    keyInput.addEventListener('input', () => { box.value = keyInput.value; });
  }
  // Keep the checkbox value in step for the rows rendered server-side too.
  document.querySelectorAll('#rows tbody tr').forEach((tr) => {
    const keyInput = tr.querySelector('input[name="key"]');
    const box = tr.querySelector('input[name="sensitive"]');
    if (keyInput && box) keyInput.addEventListener('input', () => { box.value = keyInput.value; });
  });
</script>
