<div class="page-head">
  <div>
    <h1>New workspace</h1>
    <p class="lede">A workspace groups projects and global items; you become its owner.</p>
  </div>
</div>
<% if (it.error) { %><p role="alert" class="alert"><%= it.error %></p><% } %>
<form method="post" action="/workspaces" class="form-grid">
  <input type="hidden" name="csrf" value="<%= it.csrf %>" />
  <label>Name <input name="name" value="<%= it.form.name %>" required maxlength="200" /></label>
  <label>Slug <input name="slug" value="<%= it.form.slug %>" pattern="[a-z0-9]+(-[a-z0-9]+)*" />
    <small>lowercase letters, digits and dashes; derived from the name when empty</small>
  </label>
  <div class="actions">
    <button class="btn primary" type="submit">Create workspace</button>
  </div>
</form>
