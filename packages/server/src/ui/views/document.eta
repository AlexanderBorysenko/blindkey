<p class="crumbs">
  <% if (it.prefix === '/global') { %>
  <a href="/global/docs<%= it.wsq %>">Global</a> / <a href="/global/docs<%= it.wsq %>">Documents</a> / <span class="current"><%= it.doc.title %></span>
  <% } else { %>
  <a href="/">Projects</a> / <a href="<%= it.prefix %>"><%= it.scopeLabel %></a> / <span class="current"><%= it.doc.title %></span>
  <% } %>
</p>

<div class="page-head">
  <div>
    <h1><%= it.doc.title %></h1>
    <div class="meta">
      <span class="mono"><%= it.doc.slug %></span>
      <span class="tag"><%= it.doc.category %></span>
      <span>updated <time datetime="<%= it.fmt.iso(it.doc.updated_at) %>" title="<%= it.fmt.iso(it.doc.updated_at) %>"><%= it.fmt.ago(it.doc.updated_at) %></time></span>
    </div>
  </div>
  <div class="actions">
    <% if (it.canEdit) { %><a class="btn" href="<%= it.prefix %>/docs/<%= encodeURIComponent(it.doc.slug) %>/edit<%= it.wsq %>">Edit</a><% } %>
    <% if (it.canDelete || (it.moveTargets && it.moveTargets.length)) { %>
    <details class="menu">
      <summary class="btn ghost" aria-label="More actions">⋯</summary>
      <div class="menu-list">
        <% if (it.moveTargets && it.moveTargets.length) { %><button class="btn ghost" type="button" data-open-dialog="move-item">Move to workspace…</button><% } %>
        <% if (it.canDelete) { %><button class="btn ghost danger" type="button" data-open-dialog="delete-document">Delete document…</button><% } %>
      </div>
    </details>
    <% } %>
  </div>
</div>

<% if (it.moveError) { %><p role="alert" class="alert"><%= it.moveError %></p><% } %>

<div class="doc-grid">
  <article class="doc"><%~ it.html %></article>

  <% if (it.refs.length) { %>
  <div class="panel">
    <h3>Referenced secrets</h3>
    <% it.refs.forEach(function (r) { %>
    <div>
      <a class="mono" href="<%= r.project ? '/p/' + encodeURIComponent(r.project) : '/global' %>/secrets/<%= encodeURIComponent(r.name) %>"><%= r.name %></a>
      <div class="meta">
        <% r.fields.forEach(function (f) { %>
        <% if (f.sensitive) { %>
        <span class="chip lock"><svg class="i" aria-hidden="true"><use href="#i-lock"/></svg> <%= f.key %></span>
        <% } else { %>
        <span class="chip"><%= f.key %></span>
        <% } %>
        <% }) %>
      </div>
    </div>
    <% }) %>
    <p class="note">Values are never shown here. Consume them with <code>blindkey secret exec</code>, <code>write</code> or <code>env</code>.</p>
  </div>
  <% } %>
</div>

<% if (it.canDelete) { %>
<dialog class="confirm" id="delete-document">
  <h2>Delete document</h2>
  <p>Delete <%= it.doc.title %>? This cannot be undone.</p>
  <form method="post" action="<%= it.prefix %>/docs/<%= encodeURIComponent(it.doc.slug) %>/delete">
    <input type="hidden" name="csrf" value="<%= it.csrf %>" />
    <% if (it.ws) { %><input type="hidden" name="workspace" value="<%= it.ws %>" /><% } %>
    <div class="actions">
      <button class="btn" type="button" data-close-dialog>Cancel</button>
      <button class="btn danger solid" type="submit">Delete document</button>
    </div>
  </form>
</dialog>
<% } %>

<%~ include('partials/move-dialog', { targets: it.moveTargets, action: it.prefix + '/docs/' + encodeURIComponent(it.doc.slug) + '/move', csrf: it.csrf, ws: it.ws, what: it.doc.slug }) %>
