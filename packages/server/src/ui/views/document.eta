<p class="crumbs">
  <% if (it.prefix === '/global') { %>
  <a href="/global/docs">Global</a> / <a href="/global/docs">Documents</a> / <span class="current"><%= it.doc.title %></span>
  <% } else { %>
  <a href="/">Projects</a> / <a href="<%= it.prefix %>"><%= it.scopeLabel %></a> / <span class="current"><%= it.doc.title %></span>
  <% } %>
</p>

<div class="page-head">
  <div>
    <h1><%= it.doc.title %></h1>
    <div class="meta">
      <span class="mono"><%= it.doc.slug %></span>
      <span class="tag"><%= it.doc.category %></span>
      <span>updated <time datetime="<%= it.fmt.iso(it.doc.updated_at) %>" title="<%= it.fmt.iso(it.doc.updated_at) %>"><%= it.fmt.ago(it.doc.updated_at) %></time></span>
    </div>
  </div>
  <div class="actions">
    <a class="btn" href="<%= it.prefix %>/docs/<%= encodeURIComponent(it.doc.slug) %>/edit">Edit</a>
    <details class="menu">
      <summary class="btn ghost">⋯</summary>
      <div class="menu-list">
        <button class="btn ghost danger" type="button" onclick="document.getElementById('delete-document').showModal()">Delete document…</button>
      </div>
    </details>
  </div>
</div>

<div class="doc-grid">
  <article class="doc"><%~ it.html %></article>

  <% if (it.refs.length) { %>
  <div class="panel">
    <h3>Referenced secrets</h3>
    <% it.refs.forEach(function (r) { %>
    <div>
      <a class="mono" href="<%= r.project ? '/p/' + encodeURIComponent(r.project) : '/global' %>/secrets/<%= encodeURIComponent(r.name) %>"><%= r.name %></a>
      <div class="meta">
        <% r.fields.forEach(function (f) { %>
        <% if (f.sensitive) { %>
        <span class="chip lock"><svg class="i" aria-hidden="true"><use href="#i-lock"/></svg> <%= f.key %></span>
        <% } else { %>
        <span class="chip"><%= f.key %></span>
        <% } %>
        <% }) %>
      </div>
    </div>
    <% }) %>
    <p class="note">Values are never shown here. Consume them with <code>pidb secret exec</code>, <code>write</code> or <code>env</code>.</p>
  </div>
  <% } %>
</div>

<dialog class="confirm" id="delete-document">
  <h2>Delete document</h2>
  <p>Delete <%= it.doc.title %>? This cannot be undone.</p>
  <form method="post" action="<%= it.prefix %>/docs/<%= encodeURIComponent(it.doc.slug) %>/delete">
    <input type="hidden" name="csrf" value="<%= it.csrf %>" />
    <div class="actions">
      <button class="btn" type="button" onclick="this.closest('dialog').close()">Cancel</button>
      <button class="btn danger solid" type="submit">Delete document</button>
    </div>
  </form>
</dialog>
