<p class="crumbs">
  <% if (it.prefix === '/global') { %>
  <a href="/global/docs">Global</a> / <a href="/global/docs">Documents</a> / <span class="current"><%= it.isNew ? 'New document' : it.form.slug %></span>
  <% } else { %>
  <a href="/">Projects</a> / <a href="<%= it.prefix %>"><%= it.scopeLabel %></a> / <span class="current"><%= it.isNew ? 'New document' : it.form.slug %></span>
  <% } %>
</p>

<h1><%= it.isNew ? 'New document' : 'Edit document' %></h1>

<% if (it.error) { %><div class="alert" role="alert"><%= it.error %></div><% } %>

<% if (it.findings.length || it.unresolved.length) { %>
<div class="alert warn">
  <strong>This document looks like it contains secret material.</strong>
  <ul class="findings">
    <% it.findings.forEach(function (f) { %><li>line <%= f.line %>: <%= f.reason %></li><% }) %>
    <% it.unresolved.forEach(function (u) { %><li>unresolved reference: <%= u %></li><% }) %>
  </ul>
</div>
<% } %>

<form method="post" action="<%= it.action %>">
  <input type="hidden" name="csrf" value="<%= it.csrf %>" />

  <div class="form-grid doc-fields">
    <label>Slug <input name="slug" value="<%= it.form.slug %>" required <%= it.isNew ? '' : 'readonly' %> /></label>
    <label>Title <input name="title" value="<%= it.form.title %>" required /></label>
    <label>Category
      <select name="category">
        <% it.categories.forEach(function (c) { %>
        <option value="<%= c %>"<%= it.form.category === c ? ' selected' : '' %>><%= c %></option>
        <% }) %>
      </select>
    </label>
  </div>

  <div class="editor">
    <label>Body (Markdown)
      <textarea name="body_md" rows="24"
                hx-post="/preview"
                hx-trigger="keyup changed delay:400ms"
                hx-target="#preview"
                hx-include="closest form"><%= it.form.body_md %></textarea>
    </label>
    <div id="preview"><div class="preview"><em>Preview appears as you type.</em></div></div>
  </div>

  <input type="hidden" name="scope" value="<%= it.prefix %>" />

  <div class="save-bar">
    <button class="btn primary" type="submit">Save</button>
    <% if (it.findings.length || it.unresolved.length) { %>
    <button type="submit" name="force" value="on" class="btn danger">Save anyway</button>
    <% } %>
    <a class="btn" href="<%= it.isNew ? it.prefix : it.prefix + '/docs/' + encodeURIComponent(it.form.slug) %>">Cancel</a>
  </div>
</form>
