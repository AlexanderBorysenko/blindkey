<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><%= it.title %> · pidb</title>
    <link rel="stylesheet" href="/assets/pico.min.css" />
    <link rel="stylesheet" href="/assets/app.css" />
    <script src="/assets/htmx.min.js" defer></script>
  </head>
  <body>
    <main class="container">
      <% if (it.nav) { %>
      <nav>
        <ul>
          <li><strong><a href="/">pidb</a></strong></li>
          <li><a href="/tokens">Tokens</a></li>
          <li><a href="/audit">Audit</a></li>
          <li><a href="/global/docs">Global docs</a></li>
          <li><a href="/global/secrets">Global secrets</a></li>
        </ul>
        <ul>
          <li>
            <form method="post" action="/logout">
              <input type="hidden" name="csrf" value="<%= it.csrf %>" />
              <button class="secondary outline" type="submit">Log out</button>
            </form>
          </li>
        </ul>
      </nav>
      <% } %>
      <%~ it.body %>
    </main>
  </body>
</html>
