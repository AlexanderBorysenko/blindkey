<div class="page-head">
  <div>
    <h1>API tokens</h1>
  </div>
  <div class="actions">
    <button class="btn primary" type="button" onclick="document.getElementById('new-token').showModal()">
      <svg class="i" aria-hidden="true"><use href="#i-plus"/></svg> New token
    </button>
  </div>
</div>

<% if (it.created) { %>
<div class="panel lock">
  <h3>Token created — shown once</h3>
  <div class="kv">
    <div class="kv-row">
      <div class="mono field-key">Token</div>
      <div><span class="field-value" id="new-token-value"><%= it.created.token %></span></div>
      <div><button class="btn sm ghost" type="button" onclick="copyNewToken(this)">Copy</button></div>
    </div>
  </div>
  <p class="note">Copy it now: pidb stores only a hash, so this value cannot be shown again.</p>
</div>
<% } %>

<div class="table-wrap">
  <table>
    <thead><tr><th>ID</th><th>Name</th><th>Prefix</th><th>Scopes</th><th>Projects</th><th>Expires</th><th>Last used</th><th>State</th><th></th></tr></thead>
    <tbody>
      <% if (it.tokens.length === 0) { %>
      <tr>
        <td colspan="9">
          <div class="empty">
            <p>No API tokens yet.</p>
            <button class="btn primary" type="button" onclick="document.getElementById('new-token').showModal()">New token</button>
          </div>
        </td>
      </tr>
      <% } %>
      <% it.tokens.forEach(function (t) { %>
      <tr<%~ t.revoked_at !== null ? ' class="is-archived"' : '' %>>
        <td><%= t.id %></td>
        <td><%= t.name %></td>
        <td class="mono"><%= t.prefix %></td>
        <td><% t.scopes.forEach(function (s) { %><span class="chip"><%= s %></span> <% }) %></td>
        <td><% if (t.projects === null) { %><span class="muted">all</span><% } else { %><% t.projects.forEach(function (p) { %><span class="tag"><%= p %></span> <% }) %><% } %></td>
        <td><% if (t.expires_at === null) { %>never<% } else { %><time datetime="<%= it.fmt.iso(t.expires_at) %>" title="<%= it.fmt.iso(t.expires_at) %>"><%= it.fmt.ago(t.expires_at) %></time><% } %></td>
        <td><% if (t.last_used_at === null) { %>—<% } else { %><time datetime="<%= it.fmt.iso(t.last_used_at) %>" title="<%= it.fmt.iso(t.last_used_at) %>"><%= it.fmt.ago(t.last_used_at) %></time><% } %></td>
        <td><% if (t.revoked_at === null) { %><span class="pill status-active">active</span><% } else { %><span class="pill status-archived">revoked</span><% } %></td>
        <td>
          <% if (t.revoked_at === null) { %>
          <button class="btn sm danger" type="button" onclick="document.getElementById('revoke-<%= t.id %>').showModal()">Revoke</button>
          <dialog class="confirm" id="revoke-<%= t.id %>">
            <h2>Revoke token</h2>
            <p>Revoke <%= t.name %>? Clients using it stop working immediately.</p>
            <form method="post" action="/tokens/<%= t.id %>/revoke">
              <input type="hidden" name="csrf" value="<%= it.csrf %>" />
              <div class="actions">
                <button class="btn" type="button" onclick="this.closest('dialog').close()">Cancel</button>
                <button class="btn danger solid" type="submit">Revoke</button>
              </div>
            </form>
          </dialog>
          <% } %>
        </td>
      </tr>
      <% }) %>
    </tbody>
  </table>
</div>

<dialog class="confirm" id="new-token">
  <h2>New token</h2>
  <% if (it.error) { %><p role="alert" class="alert"><%= it.error %></p><% } %>
  <form method="post" action="/tokens" class="form-grid">
    <input type="hidden" name="csrf" value="<%= it.csrf %>" />
    <label>Name <input name="name" required /></label>
    <div>
      <label>Scopes</label>
      <div class="chip-grid">
        <% it.scopes.forEach(function (s) { %>
        <label class="chip"><input type="checkbox" name="scopes" value="<%= s %>" /> <%= s %></label>
        <% }) %>
      </div>
    </div>
    <label>Projects (comma separated slugs; empty = all)
      <input name="projects" list="project-slugs" />
    </label>
    <datalist id="project-slugs">
      <% it.projects.forEach(function (p) { %><option value="<%= p.slug %>"></option><% }) %>
    </datalist>
    <label>Expires in (days; empty = never) <input name="days" type="number" min="1" /></label>
    <div class="actions">
      <button class="btn" type="button" onclick="this.closest('dialog').close()">Cancel</button>
      <button class="btn primary" type="submit">Create token</button>
    </div>
  </form>
</dialog>
<% if (it.error) { %>
<script>
  (function () {
    var dlg = document.getElementById('new-token');
    if (dlg && !dlg.open) dlg.showModal();
  })();
</script>
<% } %>
<% if (it.created) { %>
<script>
  function copyNewToken(btn) {
    var el = document.getElementById('new-token-value');
    if (!el) return;
    navigator.clipboard.writeText(el.textContent).then(function () {
      var original = btn.textContent;
      btn.textContent = 'Copied';
      setTimeout(function () { btn.textContent = original; }, 1500);
    });
  }
</script>
<% } %>
