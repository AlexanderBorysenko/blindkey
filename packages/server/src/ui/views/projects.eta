<div class="page-head">
  <div>
    <h1>Projects</h1>
  </div>
  <div class="actions">
    <button class="btn primary" type="button" data-open-dialog="new-project">
      <svg class="i" aria-hidden="true"><use href="#i-plus"/></svg> New project
    </button>
  </div>
</div>

<nav class="tabs">
  <a href="/" aria-current="<%= it.status === '' ? 'page' : 'false' %>">all</a>
  <% it.statuses.forEach(function (s) { %>
  <a href="/?status=<%= s %>" aria-current="<%= it.status === s ? 'page' : 'false' %>"><%= s %></a>
  <% }) %>
</nav>

<% if (it.projects.length === 0) { %>
<div class="empty">
  <p><% if (it.status) { %>No <%= it.status %> projects.<% } else { %>No projects yet.<% } %></p>
  <button class="btn primary" type="button" data-open-dialog="new-project">New project</button>
</div>
<% } else { %>
<div class="table-wrap">
  <table>
    <thead><tr><th>Project</th><th>Status</th><th>Tags</th><th>Updated</th></tr></thead>
    <tbody>
      <% it.projects.forEach(function (p) { %>
      <tr<%~ p.status === 'archived' ? ' class="is-archived"' : '' %>>
        <td>
          <a class="mono" href="/p/<%= encodeURIComponent(p.slug) %>"><%= p.slug %></a><br />
          <small><%= p.name %></small>
        </td>
        <td><span class="pill status-<%= p.status %>"><%= p.status %></span></td>
        <td><% p.tags.forEach(function (tag) { %><span class="tag"><%= tag %></span> <% }) %></td>
        <td><time datetime="<%= it.fmt.iso(p.updated_at) %>" title="<%= it.fmt.iso(p.updated_at) %>"><%= it.fmt.ago(p.updated_at) %></time></td>
      </tr>
      <% }) %>
    </tbody>
  </table>
</div>
<% } %>

<dialog class="confirm" id="new-project"<%~ it.error ? ' data-open-on-load' : '' %>>
  <h2>New project</h2>
  <% if (it.error) { %><p role="alert" class="alert"><%= it.error %></p><% } %>
  <form method="post" action="/projects" class="form-grid">
    <input type="hidden" name="csrf" value="<%= it.csrf %>" />
    <label>Slug <input name="slug" value="<%= it.form.slug %>" required /></label>
    <label>Name <input name="name" value="<%= it.form.name %>" required /></label>
    <label>Status
      <select name="status">
        <% it.statuses.forEach(function (s) { %>
        <option value="<%= s %>"<%= it.form.status === s ? ' selected' : '' %>><%= s %></option>
        <% }) %>
      </select>
    </label>
    <label>Tags (comma separated) <input name="tags" value="<%= it.form.tags %>" /></label>
    <label>Summary <textarea name="summary" rows="3"><%= it.form.summary %></textarea></label>
    <div class="actions">
      <button class="btn" type="button" data-close-dialog>Cancel</button>
      <button class="btn primary" type="submit">Create project</button>
    </div>
  </form>
</dialog>
