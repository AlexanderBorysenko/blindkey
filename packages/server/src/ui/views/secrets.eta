<h1>Global secrets</h1>
<table>
  <thead><tr><th>Name</th><th>Fields</th><th>Tags</th><th>Description</th></tr></thead>
  <tbody>
    <% it.secrets.forEach(function (s) { %>
    <tr>
      <td><a href="/global/secrets/<%= encodeURIComponent(s.name) %>"><%= s.name %></a></td>
      <td><% s.fields.forEach(function (f) { %><code><%= f.key %></code><% if (f.sensitive) { %>*<% } %> <% }) %></td>
      <td><%= s.tags.join(', ') %></td>
      <td><%= s.description %></td>
    </tr>
    <% }) %>
  </tbody>
</table>
<p><a role="button" href="/global/secrets/new">New secret</a></p>
