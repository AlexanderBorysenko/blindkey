<p class="crumbs"><a href="/global/secrets">Global</a> / <span class="current">Secrets</span></p>

<div class="page-head">
  <div>
    <h1>Global secrets</h1>
    <p class="lede">Secrets not tied to a project.</p>
  </div>
  <% if (it.canCreateSecret) { %>
  <div class="actions">
    <a class="btn primary" href="/global/secrets/new<%= it.wsq %>"><svg class="i" aria-hidden="true"><use href="#i-plus"/></svg> New secret</a>
  </div>
  <% } %>
</div>

<% if (it.secrets.length === 0) { %>
<div class="empty">
  <p>No secrets yet.</p>
  <% if (it.canCreateSecret) { %><a class="btn primary" href="/global/secrets/new<%= it.wsq %>">New secret</a><% } %>
</div>
<% } else { %>
<div class="table-wrap">
  <table>
    <thead><tr><th>Name</th><th>Fields</th><th>Tags</th><th>Description</th></tr></thead>
    <tbody>
      <% it.secrets.forEach(function (s) { %>
      <tr>
        <td><a class="mono" href="/global/secrets/<%= encodeURIComponent(s.name) %><%= it.wsq %>"><%= s.name %></a></td>
        <td>
          <% s.fields.forEach(function (f) { %>
          <% if (f.sensitive) { %>
          <span class="chip lock"><svg class="i" aria-hidden="true"><use href="#i-lock"/></svg> <%= f.key %></span>
          <% } else { %>
          <span class="chip"><%= f.key %></span>
          <% } %>
          <% }) %>
        </td>
        <td><% s.tags.forEach(function (tag) { %><span class="tag"><%= tag %></span> <% }) %></td>
        <td><%= s.description %></td>
      </tr>
      <% }) %>
    </tbody>
  </table>
</div>
<% } %>
