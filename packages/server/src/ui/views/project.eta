<p><a href="/">← Projects</a></p>
<h1><%= it.project.name %> <small><code><%= it.project.slug %></code></small></h1>
<p><%= it.project.status %><% if (it.project.tags.length) { %> · <%= it.project.tags.join(', ') %><% } %></p>
<% if (it.project.summary) { %><p><%= it.project.summary %></p><% } %>

<%~ include('partials/tabs', { slug: it.project.slug, tab: it.tab }) %>

<% if (it.tab === 'docs') { %>
<table>
  <thead><tr><th>Slug</th><th>Title</th><th>Category</th><th>Updated</th></tr></thead>
  <tbody>
    <% it.project.documents.forEach(function (d) { %>
    <tr>
      <td><a href="/p/<%= encodeURIComponent(it.project.slug) %>/docs/<%= encodeURIComponent(d.slug) %>"><%= d.slug %></a></td>
      <td><%= d.title %></td>
      <td><%= d.category %></td>
      <td><%= new Date(d.updated_at).toISOString().slice(0, 19) %>Z</td>
    </tr>
    <% }) %>
  </tbody>
</table>
<p><a role="button" href="/p/<%= encodeURIComponent(it.project.slug) %>/docs/new/edit">New document</a></p>
<% } else { %>
<table>
  <thead><tr><th>Name</th><th>Fields</th><th>Tags</th><th>Description</th></tr></thead>
  <tbody>
    <% it.project.secrets.forEach(function (s) { %>
    <tr>
      <td><a href="/p/<%= encodeURIComponent(it.project.slug) %>/secrets/<%= encodeURIComponent(s.name) %>"><%= s.name %></a></td>
      <td>
        <% s.fields.forEach(function (f) { %>
        <code><%= f.key %></code><% if (f.sensitive) { %>*<% } else if (f.value !== undefined) { %>=<%= f.value %><% } %>
        <% }) %>
      </td>
      <td><%= s.tags.join(', ') %></td>
      <td><%= s.description %></td>
    </tr>
    <% }) %>
  </tbody>
</table>
<p><small>* sensitive — value hidden; open the secret to reveal one field.</small></p>
<p><a role="button" href="/p/<%= encodeURIComponent(it.project.slug) %>/secrets/new">New secret</a></p>
<% } %>

<details>
  <summary>Edit project</summary>
  <form method="post" action="/p/<%= encodeURIComponent(it.project.slug) %>">
    <input type="hidden" name="csrf" value="<%= it.csrf %>" />
    <label>Name <input name="name" value="<%= it.project.name %>" required /></label>
    <label>Status
      <select name="status">
        <% it.statuses.forEach(function (s) { %>
        <option value="<%= s %>"<%= it.project.status === s ? ' selected' : '' %>><%= s %></option>
        <% }) %>
      </select>
    </label>
    <label>Tags (comma separated) <input name="tags" value="<%= it.project.tags.join(', ') %>" /></label>
    <label>Summary <textarea name="summary" rows="3"><%= it.project.summary %></textarea></label>
    <button type="submit">Save</button>
  </form>
</details>

<details>
  <summary>Danger zone</summary>
  <form method="post" action="/p/<%= encodeURIComponent(it.project.slug) %>/delete" onsubmit="return confirm('Delete this project, its documents and its secrets?');">
    <input type="hidden" name="csrf" value="<%= it.csrf %>" />
    <button class="secondary" type="submit">Delete project</button>
  </form>
</details>
