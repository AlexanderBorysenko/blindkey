#!/bin/sh
# pidb agent CLI (Claude Code plugin bin/, on the Bash tool's PATH). Resolves the plugin root from
# this script's own location — following symlinks — and runs the bundled agent-mode CLI.
self=$0
while [ -h "$self" ]; do
  dir=$(cd -P "$(dirname "$self")" && pwd)
  link=$(readlink "$self")
  case $link in
    /*) self=$link ;;
    *) self=$dir/$link ;;
  esac
done
root=$(cd -P "$(dirname "$self")/.." && pwd)
PIDB_AGENT=1
export PIDB_AGENT
exec node "$root/dist/pidb.mjs" "$@"
