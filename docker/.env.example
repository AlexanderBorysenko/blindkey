# Copy to docker/.env and fill in. NEVER put the master key in this file:
# it belongs in docker/secrets/master_key (mounted at /run/secrets/master_key).

# The hostname Caddy gets a certificate for.
BLINDKEY_DOMAIN=blindkey.example.com
# Contact address for Let's Encrypt.
BLINDKEY_ACME_EMAIL=you@example.com

# Caddy terminates TLS, so the server must trust X-Forwarded-Proto — without
# this the admin session cookie is issued without the Secure flag.
BLINDKEY_TRUST_PROXY=true

# pino level: trace | debug | info | warn | error | fatal
BLINDKEY_LOG_LEVEL=info

# Master key version, and previous versions during a rotation.
# BLINDKEY_MASTER_KEY_PREVIOUS is key material — only the server and backup
# services receive it — and delete it from this file as soon as
# `rotate-key` has finished (keep the retired key in your password manager
# while any backup wrapped with it exists). Keep BLINDKEY_MASTER_KEY_VERSION:
# without it the server assumes version 1. See README "Rotating the master key".
# BLINDKEY_MASTER_KEY_VERSION=1
# BLINDKEY_MASTER_KEY_PREVIOUS=1:<base64-of-32-bytes>

# Backup loop: interval in seconds and how many copies to keep.
BLINDKEY_BACKUP_INTERVAL=86400
BLINDKEY_BACKUP_KEEP=14
